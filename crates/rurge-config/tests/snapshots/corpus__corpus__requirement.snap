- listeners: []
  policies:
    - A (direct)
    - B (direct)
  groups:
    - "Group (url-test) -> [A, B]"
    - "Group2 (select) -> [A, B]"
  rules:
    - "DOMAIN,reject.com,REJECT"
    - "FINAL,Group"
